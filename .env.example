# Copy to .env, fill in, then: source .env && source start.sh
export GOOGLE_CLOUD_PROJECT=your-project-id   # required: the project LiteLLM bills Vertex AI calls to
export LAYA_API_KEY=local-laya                # shared secret between LiteLLM and laya-serve (both local)
# export LITELLM_MASTER_KEY=sk-change-me      # only if you turn on master_key in litellm_config.yaml
